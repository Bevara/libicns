{
    "name": "libicns",
    "version": "1.0.3",
    "description": "Apple icon (ICNS) decoder",
    "filters": [
        "icnsdec"
    ],
    "help": "This filter decodes the largest 32-bit icon of an Apple ICNS file using libicns.",
    "support": [
        "image"
    ],
    "sources": "https://bevara.ddns.net/sources/libicns.accessor",
    "filter_source": {
        "icnsdec": "dec_icns.c"
    },
    "extension": {
        "icns": "img"
    },
    "using": [
        "mm_solver_minimal_1.0.1",
        "mm_solver_1.0.1",
        "mm_solver_1.0.2",
        "mm_solver_1.0.3",
        "mm_solver_1.0.4",
        "mm_solver_1.0.5"
    ],
    "patents": {
        "status": "royalty-free",
        "note": "Apple icon container",
        "checked": "2026-10-16"
    }
}
